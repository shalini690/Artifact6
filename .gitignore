# .gitignore - Artifact6 (Node.js / Express)
#
# Repository hygiene: keeps machine-generated and local-only files out of
# version control. The committed project files (package.json, package-lock.json,
# server.js, README.md, and this .gitignore) are intentionally NOT listed here
# so they remain tracked.

# Dependencies
# npm-managed install artifact - regenerated by `npm install`; never commit it.
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables / local config
.env
.env.local
